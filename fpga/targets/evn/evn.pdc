# LIFCL-40-EVN pins (FPGA-EB-02028 v1.7). All on 3.3 V banks: the Raspberry Pi header JP5 is
# bank 6 (3.3 V with J33 on 1-2, the default), PMOD header J17 bank 7 (fixed 3.3 V), LEDs and
# SW2 bank 1 (fixed 3.3 V).
#
# JP5 (Raspberry Pi header), the Pi's SPI0 positions: 19 MOSI (lane 0), 21 MISO (lane 1),
# 23 SCK, 24 CS_N; 26 and 18 the two further lanes of a four-lane data phase; 22 DUMP_IRQ,
# 29 the event input; 25 GND. Pins 8, 10, 11, 12 can be strapped to JTAG and are left free.
ldc_set_location -site {N7} [get_ports spi_sck]
# the slave's frame logic is clocked by SCK itself: 25 MHz is the rated rate (the constraint
# goes on the net behind the input buffer, the one nextpnr times)
create_clock -period 40 -name spi_sck [get_nets rx.spi.sck]
ldc_set_location -site {N4} [get_ports {spi_io[0]}]
ldc_set_location -site {K6} [get_ports {spi_io[1]}]
ldc_set_location -site {N5} [get_ports {spi_io[2]}]
ldc_set_location -site {K7} [get_ports {spi_io[3]}]
ldc_set_location -site {P6} [get_ports spi_cs_n]
ldc_set_location -site {K5} [get_ports dump_irq]
ldc_set_location -site {K8} [get_ports evt_in]
# J17 (PMOD0): 3 sample sign, 4 sample mag. Pins 1 and 2 (D10, D9) are the GPLL0 dedicated
# clock inputs and stay free for an external reference clock.
ldc_set_location -site {D7}  [get_ports sample_sign]
ldc_set_location -site {D8}  [get_ports sample_mag]
# LED0..LED4 and push button SW2
ldc_set_location -site {E17} [get_ports {led_n[0]}]
ldc_set_location -site {F13} [get_ports {led_n[1]}]
ldc_set_location -site {G13} [get_ports {led_n[2]}]
ldc_set_location -site {F14} [get_ports {led_n[3]}]
ldc_set_location -site {L16} [get_ports {led_n[4]}]
ldc_set_location -site {G14} [get_ports btn_rst_n]
# One port per get_ports: nextpnr silently ignores a brace-grouped selector such as
# [get_ports {a b}], and build.sh counts the pulls that reach the FASM against these lines.
# SCK and the data lanes are pulled down: SCK idles at mode 0's level while the Nucleo is not
# driving it, and a lane nobody drives (every lane between frames, the read lanes during the
# dummy cycles) reads as 0. Nothing drives the sample pins or the event input on the EVN, so
# they are held at a defined level too.
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=DOWN} [get_ports spi_sck]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=DOWN} [get_ports {spi_io[0]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=DOWN} [get_ports {spi_io[1]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=DOWN} [get_ports {spi_io[2]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=DOWN} [get_ports {spi_io[3]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=UP} [get_ports spi_cs_n]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports dump_irq]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=DOWN} [get_ports evt_in]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=DOWN} [get_ports sample_sign]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=DOWN} [get_ports sample_mag]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[0]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[1]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[2]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[3]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[4]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports btn_rst_n]
